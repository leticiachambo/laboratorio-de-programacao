digraph UseCase {
  graph [rankdir=LR, fontname="Helvetica", bgcolor="white", nodesep=0.5, ranksep=1.1];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  subgraph cluster_system {
    label="Sistema de Identificação de Raças Caninas";
    fontname="Helvetica-Bold";
    style="rounded";
    color="#2C3E50";
    penwidth=1.5;
    margin=25;

    node [shape=ellipse, style=filled, fillcolor="#EAF2F8", color="#2C3E50", width=2.6, height=0.6];

    UC01 [label="UC01\nCadastrar-se"];
    UC02 [label="UC02\nAutenticar-se"];
    UC03 [label="UC03\nEnviar imagem para\nidentificação de raça"];
    UC04 [label="UC04\nVisualizar resultado\nda detecção"];
    UC05 [label="UC05\nConsultar histórico\nde detecções"];
    UC06 [label="UC06\nVisualizar painel\nde indicadores"];
    UC07 [label="UC07\nGerenciar usuários"];
    UC08 [label="UC08\nGerenciar versões\ndo modelo de IA"];
  }

  node [shape=none, style="", width=0, height=0, fillcolor=none];
  Usuario [label="Usuário", shape=plaintext];
  Admin [label="Administrador", shape=plaintext];

  Usuario -> UC01;
  Usuario -> UC02;
  Usuario -> UC03;
  Usuario -> UC04;
  Usuario -> UC05;
  Admin -> UC02;
  Admin -> UC06;
  Admin -> UC07;
  Admin -> UC08;

  Admin -> Usuario [arrowhead=empty, style=dashed, label="  herda", dir=back, constraint=false];

  UC03 -> UC02 [style=dashed, label="<<include>>", arrowhead=vee];
  UC03 -> UC04 [style=dashed, label="<<include>>", arrowhead=vee];
  UC06 -> UC05 [style=dashed, label="<<extend>>", arrowhead=vee];
}
